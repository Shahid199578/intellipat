   "source": [
    "# Create the list with specified values\n",
    "numbers = [10, 23, 4, 26, 4, 75, 24, 54]\n",
    "\n",
    "# Initialize the index\n",
    "index = 0\n",
    "\n",
    "# Use a while loop to fetch and print even numbers\n",
    "while index < len(numbers):\n",
    "    number = numbers[index]\n",
    "    if number % 2 == 0:\n",
    "        print(number)\n",
    "    index += 1"
   ]
